					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Total del evento: $ " + new java.text.DecimalFormat("#,##0.00").format($V{totalEvento})]]></textFieldExpression>
			</textField>

			</band>
		</groupFooter>
	</group>
	<title>
		<band height="60">
			<staticText>
				<reportElement x="0" y="5" width="555" height="30" uuid="59cc3d9b-7456-4cf6-8dfa-42c4097505de"/>
