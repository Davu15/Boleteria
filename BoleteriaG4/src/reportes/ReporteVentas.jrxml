			</line>

			</band>
		</groupHeader>
		<groupFooter>
			<band height="30">
			<textField isBlankWhenNull="true">
				<reportElement x="5" y="4" width="300" height="20" uuid="05bf9f9f-a801-4f1b-ac55-b6d97c73e253"/>
